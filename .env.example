# Docker Compose 环境变量示例
# 本地开发时复制此文件为 .env 并修改配置

# PostgreSQL 数据库配置
POSTGRES_DB=outbound_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here

# 后端服务器环境变量
DB_HOST=postgres
DB_PORT=5432
DB_NAME=outbound_system
DB_USER=postgres
DB_PASSWORD=your_strong_password_here
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*
LOG_LEVEL=info
